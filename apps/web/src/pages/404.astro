---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NavDock from "@/components/nav/NavDock.astro";
import Footer from "@/components/footer/Footer.astro";
---

<BaseLayout
  title="404 - Machine Unreachable | Divyanshu Kumar"
  description="The target route or machine you requested does not exist or has been decommissioned."
>
  <NavDock />

  <main id="main-content" class="error-page">
    <div class="container error-container">
      <div class="error-sticker-wrapper" aria-hidden="true">
        <picture>
          <source srcset="/photo/nayak-sticker.webp" type="image/webp" />
          <img
            src="/photo/nayak-sticker.png"
            alt="Sticker of Divyanshu Kumar"
            class="error-sticker"
            width="260"
            height="200"
            loading="eager"
          />
        </picture>
      </div>

      <div class="error-content">
        <span class="error-code">404 &middot; CONNECTION REFUSED</span>
        <h1 class="error-title">Target machine unreachable.</h1>
        <p class="error-desc">
          The requested endpoint or pipeline does not exist, has moved, or the daemon returned an unrouted path.
        </p>

        <div class="error-actions">
          <a href="/" class="btn-primary">Return to cluster home &rarr;</a>
          <a href="/work" class="btn-ghost">Browse selected work</a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .error-page {
    min-height: 80dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: calc(var(--space-16) + 2rem);
    padding-bottom: var(--section-gap);
  }

  .error-container {
    max-width: 36rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-8);
  }

  .error-sticker-wrapper {
    animation: float 4s ease-in-out infinite alternate;
  }

  .error-sticker {
    max-width: 16rem;
    height: auto;
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.35));
  }

  @keyframes float {
    0% { transform: translateY(0px) rotate(-2deg); }
    100% { transform: translateY(-8px) rotate(3deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-sticker-wrapper { animation: none; }
  }

  .error-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .error-code {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
  }

  .error-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
  }

  .error-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    max-width: 28rem;
  }

  .error-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: white;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    min-height: 44px;
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    min-height: 44px;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .btn-ghost:hover {
    background: var(--color-accent-subtle);
  }

  @media (max-width: 640px) {
    .error-page {
      padding-top: calc(var(--space-12) + 1.25rem);
    }
    .error-container {
      gap: var(--space-6);
    }
    .error-sticker {
      max-width: 12rem;
    }
    .error-title {
      font-size: clamp(1.65rem, 6vw, 2.25rem);
    }
    .btn-primary,
    .btn-ghost {
      padding: 0.65rem 1.25rem;
      font-size: 0.8125rem;
    }
  }
</style>
