---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NavDock from "@/components/nav/NavDock.astro";
import HeroSection from "@/components/hero/HeroSection.astro";
import SpotlightBentoGrid from "@/components/ui/SpotlightBentoGrid";
import Footer from "@/components/footer/Footer.astro";
import githubData from "@/data/github.json";

const caseStudies = [
  {
    slug: "debezium-host-deployment",
    title: "Host-Based Native Debezium Deployment",
    subtitle:
      "Automated systemd daemon provisioning with Ansible, eliminating container orchestration overhead for low-footprint edge targets.",
    org: "Debezium / Red Hat",
    period: "May 2024 - Aug 2024",
    featured: true,
    tags: ["Java 21", "Ansible", "Kafka CDC", "systemd", "PostgreSQL"],
    metrics: [
      { label: "Deployment Latency", value: "< 2 min" },
      { label: "Memory Footprint", value: "320 MB" },
      { label: "Kafka CDC Lag", value: "Sub-second" },
      { label: "Merged PRs", value: "8 PRs" },
    ],
  },
  {
    slug: "mit-app-inventor",
    title: "Horizontal UI Layout & Component Overhaul",
    subtitle:
      "Modernized visual design system, fixed drag-and-drop collision bugs, and resolved 14 long-standing issues in the visual programming workspace.",
    org: "MIT App Inventor",
    period: "May 2023 - Aug 2023",
    featured: true,
    tags: ["Java", "GWT", "Blockly", "UI Architecture", "Accessibility"],
    metrics: [
      { label: "Merged PRs", value: "14 PRs" },
      { label: "Issues Resolved", value: "18 Issues" },
      { label: "Active Users Impacted", value: "1M+ MAU" },
    ],
  },
  {
    slug: "ecommerce-microservices",
    title: "Event-Driven E-Commerce Microservices",
    subtitle:
      "Distributed transactions with 202 Accepted async polling, PostgreSQL pessimistic locks, and Keycloak 24 OAuth2/JWT token verification.",
    org: "Production Architecture",
    period: "2023 - Present",
    featured: false,
    tags: ["Spring Boot 3", "Kafka", "PostgreSQL", "Keycloak 24", "Docker"],
    metrics: [
      { label: "Target QPS", value: "10,000+" },
      { label: "P99 Response", value: "42 ms" },
      { label: "Inventory Race Conditions", value: "0" },
    ],
  },
  {
    slug: "open-source-map",
    title: "26 Merged PRs Across 13 Open Source Orgs",
    subtitle:
      "Traceable code footprint across CNCF, Red Hat, MIT, and Apache ecosystems, verified by public git commit signatures.",
    org: "Global Open Source Ecosystem",
    period: "2023 - 2024",
    featured: false,
    tags: ["Git", "CI/CD", "GitHub Actions", "Code Review", "Community"],
    metrics: [
      { label: "Total Merged PRs", value: "26" },
      { label: "Organizations", value: "13" },
      { label: "Ecosystems", value: "Java, Go, TS" },
    ],
  },
];

const articles = [
  {
    title: "From SSH Config to Running CDC Pipelines: Host-Based Deployment for Debezium Platform",
    url: "https://dev.to/d1vyanshukumar/from-ssh-config-to-running-cdc-pipelines-host-based-deployment-for-debezium-platform-4d02",
    description:
      "A complete architectural guide to orchestrating native host-based Debezium change data capture deployments directly from SSH configurations without container runtime overhead.",
    platform: "dev.to",
    category: "Debezium CDC",
    date: "Jul 2024",
    readTime: "7 min read",
    featured: true,
  },
  {
    title: "Building Zero-Touch Host Provisioning for the Debezium Platform",
    url: "https://dev.to/d1vyanshukumar/building-zero-touch-host-provisioning-for-the-debezium-platform-6nc",
    description:
      "Automating idempotent host provisioning with Ansible playbooks and systemd service daemons to achieve resilient, zero-downtime edge CDC instances.",
    platform: "dev.to",
    category: "Ansible & systemd",
    date: "Jul 2024",
    readTime: "6 min read",
    featured: true,
  },
  {
    title: "Pipeline Deployment & Container Lifecycle with Background Polling: Building Debezium's Host Path",
    url: "https://dev.to/d1vyanshukumar/pipeline-deployment-container-lifecycle-with-background-polling-building-debeziums-host-path-3083",
    description:
      "Implementing non-blocking HTTP 202 Accepted polling state machines, health monitoring, and asynchronous lifecycle controllers in Quarkus to eliminate gateway timeouts.",
    platform: "dev.to",
    category: "Async Lifecycle",
    date: "Jul 2024",
    readTime: "8 min read",
    featured: false,
  },
  {
    title: "Build-Time CDI in Quarkus: Why @IfBuildProperty Changed My Entire GSoC Design",
    url: "https://dev.to/d1vyanshukumar/build-time-cdi-in-quarkus-why-ifbuildproperty-changed-my-entire-gsoc-design-3o9j",
    description:
      "How compile-time dependency injection and build-time conditional bean resolution cut host agent resident memory to 34 MB and enabled instant native binary startup.",
    platform: "dev.to",
    category: "Quarkus ArC CDI",
    date: "Jun 25, 2024",
    readTime: "6 min read",
    featured: false,
  },
  {
    title: "I Learned Ansible From Scratch for My Open-Source Project — Here's the Full Breakdown",
    url: "https://dev.to/d1vyanshukumar/i-learned-ansible-from-scratch-for-my-open-source-project-heres-the-full-breakdown-3eh6",
    description:
      "A comprehensive, first-principles breakdown of mastering infrastructure-as-code: inventory configuration, idempotent roles, handler patterns, and vault secrets for production Linux hosts.",
    platform: "dev.to",
    category: "DevOps & Automation",
    date: "Jun 10, 2024",
    readTime: "7 min read",
    featured: false,
  },
  {
    title: "How I Finally Understood SSH Before Building a Real Open-Source Feature?",
    url: "https://dev.to/d1vyanshukumar/i-learned-ssh-from-scratch-for-my-open-source-project-heres-everything-step-by-step-2077",
    description:
      "Demystifying asymmetric key cryptography, agent forwarding, strict host checking, and socket tunnels for secure remote daemon orchestration in open-source systems.",
    platform: "dev.to",
    category: "Security & SSH",
    date: "Jun 10, 2024",
    readTime: "6 min read",
    featured: false,
  },
  {
    title: "GSoC Progress (Weeks 1–4) at MIT App Inventor — Building a Responsive GWT Interface",
    url: "https://dev.to/d1vyanshukumar/gsoc-progress-weeks-1-4-at-mit-app-inventor-building-a-responsive-gwt-interface-2fa4",
    description:
      "Modernizing legacy Google Web Toolkit (GWT) visual blocks, debugging drag-and-drop boundary collisions, and shipping backward-compatible responsive layouts for 1M+ active users.",
    platform: "dev.to",
    category: "MIT App Inventor",
    date: "Jun 30, 2023",
    readTime: "8 min read",
    featured: false,
  },
];
---

<BaseLayout
  title="Divyanshu Kumar | Software Engineer & Distributed Systems"
  description="Software engineer. Two-time GSoC scholar (MIT & Debezium / Red Hat). 26 merged PRs across 13 open source orgs. High-throughput distributed systems & CDC pipelines."
>
  <NavDock />

  <main id="main-content">
    <!-- Hero Section -->
    <HeroSection />

    <!-- Selected Production & Open Source Work -->
    <section class="section scroll-reveal" id="work" aria-label="Selected engineering case studies">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-eyebrow">CASE STUDIES &amp; ARCHITECTURE</span>
            <h2 class="section-title">Selected Engineering Work</h2>
          </div>
          <a href="/work" class="section-link">
            View full catalogue &rarr;
          </a>
        </div>

        <!-- Aceternity & GetLayers Spotlight Bento Grid -->
        <SpotlightBentoGrid caseStudies={caseStudies} client:load />
      </div>
    </section>

    <!-- Tech Stack Preview with Live Proof -->
    <section class="section scroll-reveal" id="stack" aria-label="Technical stack and systems expertise">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-eyebrow">CORE COMPETENCIES</span>
            <h2 class="section-title">Stack &amp; Systems Architecture</h2>
          </div>
          <a href="/stack" class="section-link">
            Detailed velocity metrics &rarr;
          </a>
        </div>

        <div class="stack-preview-grid">
          <div class="stack-card glass scroll-reveal scroll-reveal-delay-1">
            <h3 class="stack-group-title">Languages &amp; Runtimes</h3>
            <p class="stack-group-desc">
              Java, Quarkus, Spring Boot, Spring Cloud Gateway, systemd daemons, OpenAPI.
            </p>
            <div class="stack-pills">
              <span class="pill">Java 21</span>
              <span class="pill">Quarkus 3</span>
              <span class="pill">Spring Boot</span>
              <span class="pill">REST &middot; 202 Accepted</span>
            </div>
          </div>

          <div class="stack-card glass scroll-reveal scroll-reveal-delay-2">
            <h3 class="stack-group-title">Data, Streaming &amp; Locks</h3>
            <p class="stack-group-desc">
              Debezium CDC, Apache Kafka, Apache Avro, Schema Registry, PostgreSQL, sorted pessimistic locking.
            </p>
            <div class="stack-pills">
              <span class="pill">Debezium CDC</span>
              <span class="pill">Apache Kafka</span>
              <span class="pill">PostgreSQL</span>
              <span class="pill">PESSIMISTIC_WRITE</span>
            </div>
          </div>

          <div class="stack-card glass scroll-reveal scroll-reveal-delay-3">
            <h3 class="stack-group-title">Infrastructure &amp; Security</h3>
            <p class="stack-group-desc">
              Ansible automation, Docker, Kubernetes, Keycloak 24 OAuth2/JWT, Prometheus, Zipkin.
            </p>
            <div class="stack-pills">
              <span class="pill">Ansible</span>
              <span class="pill">Keycloak 24</span>
              <span class="pill">Docker &amp; K8s</span>
              <span class="pill">Resilience4j</span>
            </div>
          </div>
        </div>

        <!-- Open Source Metrics Ribbon -->
        <div class="oss-ribbon glass scroll-reveal">
          <div class="oss-col">
            <span class="oss-big">{githubData.totalPRs}</span>
            <span class="oss-sub">Total PRs</span>
          </div>
          <div class="oss-col">
            <span class="oss-big">{githubData.mergedPRs}</span>
            <span class="oss-sub">Merged PRs</span>
          </div>
          <div class="oss-col">
            <span class="oss-big">{githubData.totalRepos}</span>
            <span class="oss-sub">Repositories</span>
          </div>
          <div class="oss-col">
            <span class="oss-big">{githubData.totalOrgs}</span>
            <span class="oss-sub">Organizations</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Technical Writing -->
    <section class="section scroll-reveal" id="writing" aria-label="Technical writing and publications">
      <div class="container">
        <div class="section-header">
          <div>
            <span class="section-eyebrow">PUBLICATIONS</span>
            <h2 class="section-title">Technical Deep Dives</h2>
          </div>
          <a href="https://dev.to/d1vyanshukumar" target="_blank" rel="noopener noreferrer" class="section-link">
            dev.to profile &nearr;
          </a>
        </div>

        <div class="articles-grid">
          {articles.map((art, idx) => (
            <a
              href={art.url}
              class={`article-card glass scroll-reveal scroll-reveal-delay-${(idx % 4) + 1}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="article-top">
                <div class="article-badges">
                  <span class="article-platform-badge">{art.platform}</span>
                  <span class="article-cat-badge">{art.category}</span>
                </div>
                <span class="article-date">{art.date} &middot; {art.readTime}</span>
              </div>
              <h3 class="article-title">{art.title}</h3>
              <p class="article-desc">{art.description}</p>
              <div class="article-footer">
                <span class="article-cta">
                  Read on dev.to <span class="cta-arrow">&nearr;</span>
                </span>
                <span class="article-reading-pill">Verified Technical Deep Dive</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-8);
    gap: var(--space-4);
  }

  .section-eyebrow {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  .section-link {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-weight: var(--weight-medium);
    transition: color var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  .section-link:hover {
    color: var(--color-accent);
  }

  /* Bento Grid */
  :global(.bento-grid-container) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    width: 100%;
  }

  :global(.bento-col-span-2) {
    grid-column: span 2;
  }

  @media (max-width: 860px) {
    :global(.bento-grid-container) {
      grid-template-columns: 1fr;
    }
    :global(.bento-col-span-2) {
      grid-column: span 1;
    }
  }

  @media (max-width: 640px) {
    :global(.bento-card-wrapper .glass) {
      padding: 1.25rem !important;
    }
    :global(.bento-metrics-row) {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.65rem !important;
    }
  }

  @media (max-width: 360px) {
    :global(.bento-card-wrapper .glass) {
      padding: 1rem 0.85rem !important;
    }
  }

  /* Stack Preview Grid */
  .stack-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .stack-card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .stack-group-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .stack-group-desc {
    font-size: var(--text-xs);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .stack-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .pill {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  /* OSS Ribbon */
  .oss-ribbon {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: var(--space-4);
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .oss-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .oss-big {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    font-family: var(--font-mono);
    color: var(--color-text);
  }

  .oss-sub {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  /* Articles Grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: var(--space-6);
  }

  .article-card {
    padding: var(--space-6);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    position: relative;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    transition:
      transform var(--duration-fast) var(--ease-spring),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .article-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.15), 0 0 20px var(--color-accent-subtle);
  }

  .article-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .article-badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .article-platform-badge {
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    background: var(--color-accent-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-accent);
    font-size: 0.6875rem;
  }

  .article-cat-badge {
    color: var(--color-text-secondary);
    font-weight: var(--weight-medium);
    background: var(--color-surface-elevated);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    font-size: 0.6875rem;
  }

  .article-date {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .article-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .article-card:hover .article-title {
    color: var(--color-accent);
  }

  .article-desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .article-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
    gap: var(--space-2);
  }

  .article-cta {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .cta-arrow {
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .article-card:hover .cta-arrow {
    transform: translate(2px, -2px);
  }

  .article-reading-pill {
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--color-muted);
  }

  @media (max-width: 640px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      margin-bottom: var(--space-6);
    }
    .stack-card,
    .article-card {
      padding: 1.25rem 1rem;
    }
    .oss-ribbon {
      grid-template-columns: repeat(2, 1fr);
      padding: 1.25rem 0.85rem;
      gap: 0.75rem;
    }
    .oss-big {
      font-size: var(--text-2xl);
    }
    .article-footer {
      flex-wrap: wrap;
      gap: 0.5rem;
    }
  }

  @media (max-width: 380px) {
    .section-title {
      font-size: var(--text-2xl);
    }
    .stack-card,
    .article-card {
      padding: 1rem 0.85rem;
    }
    .oss-ribbon {
      padding: 1rem 0.65rem;
      gap: 0.5rem;
    }
    .oss-big {
      font-size: 1.5rem;
    }
    .article-title {
      font-size: 1.05rem;
    }
  }
</style>
