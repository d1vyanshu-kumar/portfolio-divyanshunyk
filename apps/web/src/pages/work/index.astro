---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NavDock from "@/components/nav/NavDock.astro";
import Footer from "@/components/footer/Footer.astro";
import { caseStudies } from "@/data/case-studies";
---

<BaseLayout
  title="Selected Work & Case Studies | Divyanshu Kumar"
  description="Deep-dive architectural case studies: host-based CDC orchestration, mobile-responsive layout transformation, and event-driven microservices."
>
  <NavDock />

  <main id="main-content" class="work-page">
    <div class="container work-container">
      <header class="work-header">
        <span class="work-eyebrow">ENGINEERING CASE STUDIES</span>
        <h1 class="work-title">Infrastructure nobody sees<br />until it breaks.</h1>
        <p class="work-intro">
          Production systems engineering spanning distributed CDC engines, responsive compilers, and event-driven microservices. Every claim links to public code, PRs, or design documents.
        </p>
      </header>

      <div class="case-studies-grid">
        {caseStudies.map((study) => (
          <article class="study-card glass">
            <div class="card-top">
              <div class="tags-row">
                {study.tags.slice(0, 4).map((tag) => (
                  <span class="card-tag">{tag}</span>
                ))}
              </div>
              <span class="card-period">{study.period}</span>
            </div>

            <h2 class="card-title">
              <a href={`/work/${study.slug}`} class="card-title-link">
                {study.title}
              </a>
            </h2>

            <p class="card-subtitle">{study.subtitle}</p>

            <div class="card-metrics-row">
              {study.metrics.slice(0, 3).map(({ label, value }) => (
                <div class="card-metric">
                  <span class="metric-val">{value}</span>
                  <span class="metric-lbl">{label}</span>
                </div>
              ))}
            </div>

            <div class="card-footer">
              <span class="card-org">{study.org}</span>
              <a href={`/work/${study.slug}`} class="card-cta">
                Read architecture deep dive &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .work-page {
    padding-top: calc(var(--space-16) + 2rem);
    padding-bottom: var(--section-gap);
  }

  .work-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .work-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 48rem;
  }

  .work-eyebrow {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-caps);
  }

  .work-title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text);
    line-height: var(--leading-tight);
  }

  .work-intro {
    font-size: var(--text-lg);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
  }

  /* Grid */
  .case-studies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: var(--space-6);
  }

  .study-card {
    padding: var(--space-8);
    border-radius: var(--radius-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      transform var(--duration-fast) var(--ease-spring),
      border-color var(--duration-fast) var(--ease-out);
  }

  .study-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card-tag {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .card-period {
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .card-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .card-title-link {
    text-decoration: none;
    color: inherit;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .card-title-link:hover {
    color: var(--color-accent);
  }

  .card-subtitle {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .card-metrics-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
  }

  .card-metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .metric-val {
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  .metric-lbl {
    font-size: 0.6875rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .card-org {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }

  .card-cta {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-accent);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .card-cta:hover {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .work-page {
      padding-top: calc(var(--space-12) + 1.25rem);
    }
    .work-container {
      gap: var(--space-8);
    }
    .study-card {
      padding: 1.35rem 1.15rem;
      border-radius: var(--radius-xl);
      gap: var(--space-3);
    }
    .card-title {
      font-size: var(--text-xl);
    }
    .card-metrics-row {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
      padding-block: var(--space-3);
    }
  }

  @media (max-width: 480px) {
    .work-title {
      font-size: clamp(1.85rem, 6.5vw, 2.5rem);
    }
  }

  @media (max-width: 360px) {
    .study-card {
      padding: 1rem 0.85rem;
    }
    .card-metrics-row {
      grid-template-columns: 1fr;
    }
  }
</style>
