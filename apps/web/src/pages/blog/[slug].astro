---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NavDock from '@/components/nav/NavDock.astro';
import Footer from '@/components/footer/Footer.astro';
import BlogPost from '@/components/blog/BlogPost';
import { getPublishedPosts } from '@/lib/supabase';

export async function getStaticPaths() {
  try {
    const posts = await getPublishedPosts();
    if (!posts || posts.length === 0) {
      return [{ params: { slug: 'welcome' } }];
    }
    return posts.map((post) => ({
      params: { slug: post.slug },
    }));
  } catch {
    return [{ params: { slug: 'welcome' } }];
  }
}

const { slug } = Astro.params;
---

<BaseLayout
  title="Post | Divyanshu Kumar"
  description="Read this post on Divyanshu Kumar's blog."
>
  <NavDock />

  <main id="main-content" class="blog-post-page">
    <BlogPost slug={slug ?? ''} client:load />
  </main>

  <Footer />
</BaseLayout>

<style>
  .blog-post-page {
    min-height: 100vh;
    padding-top: var(--nav-height, 80px);
  }
</style>
