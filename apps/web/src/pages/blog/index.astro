---
import BaseLayout from "@/layouts/BaseLayout.astro";
import NavDock from "@/components/nav/NavDock.astro";
import Footer from "@/components/footer/Footer.astro";
import BlogIndex from "@/components/blog/BlogIndex";
---

<BaseLayout
  title="Blog | Divyanshu Kumar"
  description="LIFEMODE, DEEP WORK, SET GOALS, BRAINROTS — raw thoughts, engineering deep dives, ambitions, and wild ideas."
>
  <NavDock />

  <main id="main-content" class="blog-page">
    <div class="container blog-container">
      <header class="blog-header">
        <span class="blog-eyebrow">THE MIND DUMP</span>
        <h1 class="blog-title">
          Thoughts that<br /><em>live rent-free.</em>
        </h1>
        <p class="blog-intro">
          This is where I write. No filters. Real engineering, real life, real goals, real brainrots.
          Pick a vibe and dive in.
        </p>
      </header>

      <BlogIndex client:load />
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .blog-page {
    min-height: 100vh;
    padding-top: var(--nav-height, 80px);
  }
  .blog-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }
  .blog-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .blog-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--clr-accent, #c9a96e);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .blog-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--clr-text, #2c1a0e);
    margin: 0 0 1.5rem;
  }
  .blog-title em {
    font-style: italic;
    color: var(--clr-accent, #c9a96e);
  }
  .blog-intro {
    font-size: 1.125rem;
    color: var(--clr-text-muted, #7a6652);
    max-width: 540px;
    margin: 0 auto;
    line-height: 1.6;
  }
</style>