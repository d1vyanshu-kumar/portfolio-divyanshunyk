---
import HeroProfileCard from "./HeroProfileCard.astro";
import LiveCdcConsole from "./LiveCdcConsole.astro";
import StatusChip from "@/components/ui/StatusChip.astro";
import Interactive3DBackground from "@/components/canvas/Interactive3DBackground.astro";

const stats = [
  { value: "2×", label: "GSoC Scholar", note: "MIT & Debezium" },
  { value: "26", label: "Merged PRs", note: "13 Open Source Orgs" },
  { value: "13", label: "Organizations", note: "Red Hat · MIT · CNCF" },
  { value: "99.99%", label: "Target Uptime", note: "Distributed CDC" },
];
---

<section class="hero-stage" aria-label="Introduction">
  <!-- ThreeUI 3D Interactive WebGL Wave & Particle Mesh -->
  <Interactive3DBackground />

  <div class="container hero-container">
    <!-- Top Split Stage: Headline & Cinematic Desktop Portrait -->
    <div class="hero-split-grid">
      <!-- Left Column: Visionary Headline & Credibility -->
      <div class="hero-text-col">
        <div class="hero-badge-row">
          <StatusChip text="Open to Full-Time & Founding Roles" />
          <span class="hero-tech-pill">Java, Go, TS &middot; Kafka CDC</span>
        </div>

        <h1 class="hero-title">
          Software engineer.
          <br />
          <span class="gradient-text-shimmer">I make systems reach</span>
          <br />
          the machines they were
          <br />
          <em class="hero-italic">never designed for.</em>
        </h1>

        <p class="hero-lead">
          Two-time Google Summer of Code contributor (MIT App Inventor, Debezium / Red Hat).
          26 merged pull requests across 13 open source organizations. Specializing in high-throughput
          distributed systems, CDC pipelines, and zero-downtime automation.
        </p>

        <div class="hero-actions-row">
          <a href="/work" class="btn-primary-3d">
            <span>Explore selected work</span>
            <span class="btn-arrow">&rarr;</span>
          </a>
          <a href="/contact" class="btn-ghost-3d">
            <span>Get in touch</span>
          </a>
          <button type="button" class="btn-cmdk-hint" data-open-command-palette aria-label="Open command palette">
            <kbd class="kbd-key">⌘</kbd><kbd class="kbd-key">K</kbd>
          </button>
        </div>

        <!-- Metrics Proof Strip -->
        <div class="hero-stats-strip glass">
          {stats.map(({ value, label, note }) => (
            <div class="hero-stat-block">
              <span class="stat-num">{value}</span>
              <span class="stat-name">{label}</span>
              <span class="stat-note">{note}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Interactive 3D Cinematic Desktop Portrait Stage -->
      <div class="hero-visual-col">
        <HeroProfileCard />
      </div>
    </div>

    <!-- Live Interactive CDC Streaming Terminal Simulator (Mistral / Retro-Futuristic) -->
    <div class="hero-console-section" id="cdc-simulator">
      <div class="console-label-row">
        <div class="console-title-group">
          <span class="console-sub-label">INTERACTIVE REVERSE ENGINEERING SIMULATOR</span>
          <span class="console-tag-pill">LIVE KAFKA &middot; DEBEZIUM CDC</span>
        </div>
        <span class="console-live-tag">
          <span class="pulse-beacon"></span>
          REAL-TIME TELEMETRY
        </span>
      </div>
      <LiveCdcConsole />
    </div>
  </div>
</section>

<style>
  .hero-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--space-16) + 2.5rem);
    padding-bottom: var(--space-16);
  }

  .hero-container {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .hero-split-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 1280px) {
    .hero-split-grid {
      grid-template-columns: 1.1fr 1.05fr;
      gap: var(--space-12);
    }
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-badge-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-tech-pill {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .hero-title {
    font-size: clamp(1.85rem, 6.5vw, 3.75rem);
    font-weight: var(--weight-bold);
    line-height: 1.1;
    letter-spacing: var(--tracking-tighter);
    color: var(--color-text);
  }

  .gradient-text-shimmer {
    background: linear-gradient(
      135deg,
      #ff5436 0%,
      #ff8a00 35%,
      #ffd600 70%,
      #ff5436 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: textShimmer 6s linear infinite;
  }

  @keyframes textShimmer {
    to {
      background-position: 200% center;
    }
  }

  .hero-italic {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
  }

  .hero-lead {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 38rem;
    font-weight: 500;
  }

  .hero-actions-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
  }

  .btn-primary-3d {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    background: linear-gradient(135deg, #ff5436, #ff7a62);
    color: white;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    box-shadow: 0 10px 25px -5px rgba(255, 84, 54, 0.4);
    transition:
      transform var(--duration-fast) var(--ease-spring),
      box-shadow var(--duration-fast) var(--ease-out);
    min-height: 48px;
  }

  .btn-primary-3d:hover {
    transform: translateY(-2px);
    box-shadow: 0 15px 30px -5px rgba(255, 84, 54, 0.6);
  }

  .btn-arrow {
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .btn-primary-3d:hover .btn-arrow {
    transform: translateX(3px);
  }

  .btn-ghost-3d {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    min-height: 48px;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .btn-ghost-3d:hover {
    background: var(--color-accent-subtle);
    border-color: var(--color-border-hover);
  }

  .btn-cmdk-hint {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    cursor: pointer;
    min-height: 48px;
  }

  .kbd-key {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* Stats Strip */
  .hero-stats-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-xl);
    margin-top: var(--space-2);
  }

  .hero-stat-block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stat-num {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  .stat-name {
    font-size: 0.6875rem;
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .stat-note {
    font-size: 0.625rem;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  /* Right Visual Column */
  .hero-visual-col {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
  }

  /* Simulator Console Section */
  .hero-console-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
    width: 100%;
  }

  .console-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-inline: var(--space-1);
  }

  .console-title-group {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .console-sub-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text);
    letter-spacing: var(--tracking-caps);
    font-weight: 700;
  }

  .console-tag-pill {
    font-size: 0.625rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-full);
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
  }

  .console-live-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.6875rem;
    font-family: var(--font-mono);
    color: var(--color-open-to-work);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
  }

  .pulse-beacon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-open-to-work);
    box-shadow: 0 0 8px var(--color-open-to-work);
    animation: beaconPulse 1.8s ease-in-out infinite;
  }

  @keyframes beaconPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  @media (max-width: 960px) {
    .hero-split-grid {
      grid-template-columns: 1fr;
    }
    .hero-stats-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .hero-stage {
      padding-top: calc(var(--space-12) + 1.25rem);
      padding-bottom: var(--space-10);
    }
    .hero-container {
      gap: var(--space-8);
    }
    .hero-text-col {
      gap: var(--space-4);
    }
    .btn-cmdk-hint {
      display: none;
    }
    .console-label-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }

  @media (max-width: 480px) {
    .hero-stats-strip {
      padding: 0.85rem 1rem;
      gap: 0.75rem;
    }
    .stat-num {
      font-size: 1.45rem;
    }
    .btn-primary-3d,
    .btn-ghost-3d {
      padding: 0.7rem 1.15rem;
      font-size: 0.8125rem;
      min-height: 44px;
    }
    .hero-actions-row {
      gap: 0.5rem;
    }
    .console-sub-label {
      font-size: 0.6875rem;
    }
  }

  @media (max-width: 360px) {
    .hero-stats-strip {
      padding: 0.75rem 0.65rem;
      gap: 0.5rem;
    }
    .stat-num {
      font-size: 1.25rem;
    }
    .stat-name {
      font-size: 0.625rem;
    }
  }
</style>
