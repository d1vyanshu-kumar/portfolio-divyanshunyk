    position: absolute;
    inset: 2px;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.15);
    pointer-events: none;
    z-index: 1;
  }

  .vinyl-groove-inner {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    pointer-events: none;
    z-index: 1;
  }

  .vinyl-art {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    object-fit: cover;
    z-index: 2;
    display: none;
  }

  .vinyl-art.has-art {
    display: block;
  }

  .vinyl-placeholder {
