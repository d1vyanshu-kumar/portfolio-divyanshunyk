    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl-disc {
      animation: none !important;
    }
  }

  .music-pill {
      flex-wrap: wrap;
      padding: 0.35rem 0.65rem;
    }
    .footer-meta {
      font-size: 0.6875rem;
      gap: 0.35rem;
    }
    .footer-social {
      gap: 0.75rem;
    }
    .footer-social-link {
      font-size: 0.8125rem;
      min-height: 38px;
    }
  }
</style>

<script>
  function initMusicWidget() {
    const pill = document.getElementById("music-pill");
    const disc = document.getElementById("vinyl-disc");
    const cover = document.getElementById("vinyl-cover") as HTMLImageElement | null;
    const placeholder = document.getElementById("vinyl-placeholder");
    const pulse = document.getElementById("music-pulse");
    const label = document.getElementById("music-label");
    const trackEl = document.getElementById("music-track");

    if (!pill || !label || !trackEl) return;

    const USER = "div_xo";
    const API_KEY = "abdae9953b777a5d5c3c4e201d987cbc";
    const URL = `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${USER}&api_key=${API_KEY}&format=json&limit=1`;

    async function fetchTrack() {
      if (!pill || !label || !trackEl) return;
      try {
        const res = await fetch(URL);
        if (!res.ok) return;
        const data = await res.json();
        const tracks = data?.recenttracks?.track;
        if (!tracks || tracks.length === 0) return;

        const latest = Array.isArray(tracks) ? tracks[0] : tracks;
        const isNowPlaying = latest?.["@attr"]?.nowplaying === "true";
        const songName = latest?.name || "";
        const artistName = latest?.artist?.["#text"] || latest?.artist?.name || "";

        // Album cover art
        const images = latest?.image;
        let albumUrl = "";
        if (Array.isArray(images) && images.length > 0) {
          albumUrl = images[1]?.["#text"] || images[2]?.["#text"] || images[0]?.["#text"] || "";
        }

        if (albumUrl && cover && placeholder) {
          cover.src = albumUrl;
          cover.classList.add("has-art");
          placeholder.classList.add("has-art");
        }

        if (songName) {
          if (isNowPlaying) {
            label.textContent = "Listening to Spotify:";
            trackEl.textContent = `${songName} · ${artistName}`;
            pulse?.classList.remove("pulse-paused");
            disc?.classList.remove("paused");
            pill.setAttribute("title", `Now playing: ${songName} by ${artistName}`);
          } else {
            label.textContent = "Recently played:";
            trackEl.textContent = `${songName} · ${artistName}`;
            pulse?.classList.add("pulse-paused");
            disc?.classList.add("paused");
            pill.setAttribute("title", `Recently played: ${songName} by ${artistName}`);
          }
          if (latest?.url) {
            pill.setAttribute("href", latest.url);
          }
        }
      } catch (e) {
        // Fallback silently
      }
    }

    fetchTrack();
    const timer = setInterval(fetchTrack, 25000);
    return () => clearInterval(timer);
  }

  initMusicWidget();
  document.addEventListener("astro:page-load", initMusicWidget);
</script>
