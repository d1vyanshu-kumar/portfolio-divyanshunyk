---
const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;

// Dynamic next chapter mapping
interface Chapter {
  label: string;
  title: string;
  href: string;
}

let nextChapter: Chapter;

if (currentPath === "/work" || currentPath.startsWith("/work/")) {
  nextChapter = {
    label: "Next chapter",
    title: "Technology Stack & Metrics",
    href: "/stack",
  };
} else if (currentPath === "/stack" || currentPath.startsWith("/stack/")) {
  nextChapter = {
    label: "Next chapter",
    title: "Get in touch & Connect",
    href: "/contact",
  };
} else if (currentPath === "/contact") {
  nextChapter = {
    label: "Back to start",
    title: "Return to Homepage",
    href: "/",
  };
} else {
  // Default (e.g. Home or 404)
  nextChapter = {
    label: "Next chapter",
    title: "Selected Work & Case Studies",
    href: "/work",
  };
}

const socialLinks = [
  { label: "GitHub", href: "https://github.com/d1vyanshu-kumar" },
  { label: "LinkedIn", href: "https://linkedin.com/in/divyanshu-kumar-24026b296" },
  { label: "X", href: "https://x.com/NykDivyanshu" },
  { label: "dev.to", href: "https://dev.to/d1vyanshukumar" },
];
---

<footer class="footer section" id="footer" aria-label="Footer">
  <div class="container footer-inner">
    <!-- Next Chapter Banner -->
    <div class="footer-top">
      <a href={nextChapter.href} class="footer-next-chapter">
        <span class="footer-next-label">{nextChapter.label}</span>
        <span class="footer-next-title">{nextChapter.title} &rarr;</span>
      </a>
    </div>

    <!-- Music / Live Spotify & Last.fm Badge & Status -->
    <div class="footer-middle">
      <a
        id="music-pill"
        class="music-pill"
        href="https://www.last.fm/user/div_xo"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Live music status on Spotify / Last.fm"
        title="View profile on Last.fm"
      >
        <!-- Revolving mini vinyl disc with album art sticker -->
        <span class="vinyl-disc" id="vinyl-disc" aria-hidden="true">
          <span class="vinyl-groove-outer"></span>
          <span class="vinyl-groove-inner"></span>
          <img
            id="vinyl-cover"
            class="vinyl-art"
            src=""
            alt=""
            loading="lazy"
          />
          <span class="vinyl-placeholder" id="vinyl-placeholder">🎧</span>
          <span class="vinyl-spindle"></span>
        </span>

        <span class="music-pulse" id="music-pulse" aria-hidden="true">
          <span class="pulse-bar bar-1"></span>
          <span class="pulse-bar bar-2"></span>
          <span class="pulse-bar bar-3"></span>
        </span>
        <span class="music-text">
          <span class="music-label" id="music-label">Listening to Spotify:</span>
          <span class="music-track" id="music-track">Connected · div_xo</span>
        </span>
      </a>

      <div class="footer-status-text">
        <span class="status-dot" aria-hidden="true"></span>
        <span>Based in Gurugram, India &middot; Open to remote or relocation</span>
      </div>
    </div>

    <!-- Bottom Metadata & Links -->
    <div class="footer-bottom">
      <div class="footer-meta">
        <span class="footer-copyright">&copy; {currentYear} Divyanshu Kumar</span>
        <span class="footer-separator" aria-hidden="true">&middot;</span>
        <span class="footer-credit">Stack-agnostic legacy whisperer</span>
        <span class="footer-separator" aria-hidden="true">&middot;</span>
        <span class="footer-credit">Architecting zero-downtime distributed scale</span>
      </div>

      <nav class="footer-social" aria-label="Social and developer links">
        {socialLinks.map(({ label, href }) => (
          <a
            href={href}
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            {label} &nearr;
          </a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .footer-next-chapter {
    display: inline-flex;
    flex-direction: column;
    gap: var(--space-2);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-spring);
  }

  .footer-next-chapter:hover {
    transform: translateX(4px);
  }

  .footer-next-label {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-semibold);
  }

  .footer-next-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    letter-spacing: var(--tracking-tight);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-next-chapter:hover .footer-next-title {
    color: var(--color-accent);
  }

  /* Music Pill */
  .footer-middle {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block: 1px solid var(--color-border);
  }

    /* Revolving Vinyl Record Disc */
  .vinyl-disc {
    position: relative;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, #2a2a30 0%, #151518 45%, #050508 100%);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4), inset 0 0 0 1px rgba(255, 255, 255, 0.15);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
    animation: vinyl-spin 4s linear infinite;
    transform-origin: center center;
  }

  .vinyl-disc.paused {
    animation-play-state: paused;
  }

  .vinyl-groove-outer {
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    border: 1px dashed rgba(255, 255, 255, 0.15);
    pointer-events: none;
    z-index: 1;
  }

  .vinyl-groove-inner {
    position: absolute;
    inset: 4px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    pointer-events: none;
    z-index: 1;
  }

  .vinyl-art {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    object-fit: cover;
    z-index: 2;
    display: none;
  }

  .vinyl-art.has-art {
    display: block;
  }

  .vinyl-placeholder {
    font-size: 10px;
    line-height: 1;
    z-index: 2;
    display: block;
    opacity: 0.8;
  }

  .vinyl-placeholder.has-art {
    display: none;
  }

  .vinyl-spindle {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #0B0B0D;
    border: 0.5px solid rgba(255, 255, 255, 0.6);
    z-index: 3;
    pointer-events: none;
  }

  @keyframes vinyl-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vinyl-disc {
      animation: none !important;
    }
  }

  .music-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }

  .music-pulse {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 12px;
  }

  .music-pill:hover { border-color: var(--color-accent); transform: translateY(-1px); transition: all 0.2s ease; }
  .music-pulse.pulse-paused .pulse-bar { animation: none; opacity: 0.45; }
  .pulse-bar {
    width: 2px;
    background: var(--color-open-to-work);
    border-radius: 1px;
    animation: bounce 1.2s ease-in-out infinite alternate;
  }

  .bar-1 { height: 8px; animation-delay: 0.1s; }
  .bar-2 { height: 12px; animation-delay: 0.3s; }
  .bar-3 { height: 6px; animation-delay: 0.5s; }

  @keyframes bounce {
    0% { transform: scaleY(0.4); }
    100% { transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .music-pill:hover { border-color: var(--color-accent); transform: translateY(-1px); transition: all 0.2s ease; }
  .music-pulse.pulse-paused .pulse-bar { animation: none; opacity: 0.45; }
  .pulse-bar { animation: none; }
  }

  .music-text {
    display: flex;
    gap: var(--space-1);
    color: var(--color-muted);
  }

  .music-track {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .footer-status-text {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-open-to-work);
  }

  /* Bottom */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .footer-separator {
    opacity: 0.4;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-social-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-weight: var(--weight-medium);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-social-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .footer {
      padding-top: var(--space-10);
      padding-bottom: var(--space-8);
    }
    .footer-inner {
      gap: var(--space-8);
    }
    .footer-bottom,
    .footer-middle {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }

  @media (max-width: 480px) {
    .footer-next-title {
      font-size: clamp(1.35rem, 5.5vw, 1.85rem);
    }
      /* Revolving Vinyl Record Disc */
