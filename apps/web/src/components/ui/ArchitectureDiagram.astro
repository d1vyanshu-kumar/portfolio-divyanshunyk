---
interface Props {
  type: "debezium" | "mit" | "ecommerce" | "opensource";
}

const { type } = Astro.props;
---

<div class="diagram-wrapper glass" aria-label={`Architecture diagram for ${type}`}>
  {type === "debezium" && (
    <svg viewBox="0 0 800 420" fill="none" xmlns="http://www.w3.org/2000/svg" class="arch-svg">
      <defs>
        <linearGradient id="dbzGrad" x1="0" y1="0" x2="800" y2="420" gradientUnits="userSpaceOnUse">
          <stop stop-color="var(--color-surface)" />
          <stop offset="1" stop-color="var(--color-bg)" />
        </linearGradient>
        <marker id="arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 1 L 8 5 L 0 9 z" fill="var(--color-accent)" />
        </marker>
      </defs>

      <!-- Background card -->
      <rect x="2" y="2" width="796" height="416" rx="16" fill="url(#dbzGrad)" stroke="var(--color-border)" stroke-width="1" />

      <!-- Section: Orchestration Engine -->
      <rect x="30" y="30" width="340" height="360" rx="12" fill="var(--color-surface)" stroke="var(--color-border)" stroke-dasharray="4 4" />
      <text x="50" y="60" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12" font-weight="600" letter-spacing="1">DEBEZIUM PLATFORM CONDUCTOR</text>

      <!-- Box: SSH Config Watcher -->
      <g class="diagram-node">
        <rect x="50" y="85" width="300" height="65" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" stroke-width="1" />
        <text x="70" y="112" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="600">~/.ssh/config WatchService</text>
        <text x="70" y="133" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">Java NIO debounced file events</text>
      </g>

      <!-- Box: Scheduler & Locks -->
      <g class="diagram-node">
        <rect x="50" y="180" width="300" height="65" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" stroke-width="1" />
        <text x="70" y="207" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="600">Sorted Pessimistic Lock Scheduler</text>
        <text x="70" y="228" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">Prevents DB deadlocks &amp; port collisions</text>
      </g>

      <!-- Box: Ansible Runner Pool -->
      <g class="diagram-node">
        <rect x="50" y="275" width="300" height="65" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" stroke-width="1" />
        <text x="70" y="302" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="600">Isolated Ansible Thread Pool</text>
        <text x="70" y="323" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">Idempotent provisioning execution</text>
      </g>

      <!-- Section: Remote Target Host -->
      <rect x="430" y="30" width="340" height="360" rx="12" fill="var(--color-surface)" stroke="var(--color-border)" stroke-dasharray="4 4" />
      <text x="450" y="60" fill="var(--color-accent)" font-family="var(--font-mono)" font-size="12" font-weight="600" letter-spacing="1">REMOTE BARE METAL / VM HOST</text>

      <!-- Box: Host Agent Daemon -->
      <g class="diagram-node">
        <rect x="450" y="85" width="300" height="85" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" stroke-width="1" />
        <text x="470" y="112" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="600">Host Agent Daemon (Quarkus)</text>
        <text x="470" y="132" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">systemd unit &middot; 6 REST endpoints</text>
        <text x="470" y="152" fill="var(--color-open-to-work)" font-family="var(--font-mono)" font-size="11">&bull; Returns 202 Accepted (Non-blocking)</text>
      </g>

      <!-- Box: Containerized CDC Engine -->
      <g class="diagram-node">
        <rect x="450" y="200" width="300" height="85" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" stroke-width="1" />
        <text x="470" y="227" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="600">Debezium Server Container</text>
        <text x="470" y="247" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">Pre-pulled image (~500 MB)</text>
        <text x="470" y="267" fill="var(--color-accent)" font-family="var(--font-mono)" font-size="11">Source DB WAL &rarr; Event Stream</text>
      </g>

      <!-- Connector Arrows -->
      <path d="M 200 150 L 200 180" stroke="var(--color-border-hover)" stroke-width="2" marker-end="url(#arrow)" />
      <path d="M 200 245 L 200 275" stroke="var(--color-border-hover)" stroke-width="2" marker-end="url(#arrow)" />
      <path d="M 350 307 C 390 307, 390 127, 445 127" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="6 4" class="anim-flow-line" marker-end="url(#arrow)" />
      <path d="M 600 170 L 600 200" stroke="var(--color-open-to-work)" stroke-width="2" marker-end="url(#arrow)" />
    </svg>
  )}

  {type === "mit" && (
    <svg viewBox="0 0 800 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="arch-svg">
      <rect x="2" y="2" width="796" height="376" rx="16" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1" />
      <text x="40" y="50" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12" font-weight="600" letter-spacing="1">MIT APP INVENTOR MOBILE INTERACTION ARCHITECTURE</text>

      <!-- Screen Mockup -->
      <rect x="40" y="75" width="220" height="270" rx="16" fill="var(--color-bg)" stroke="var(--color-border)" stroke-width="2" />
      <text x="60" y="105" fill="var(--color-accent)" font-family="var(--font-sans)" font-size="13" font-weight="700">Phone Canvas</text>
      <rect x="55" y="120" width="190" height="150" rx="8" fill="var(--color-surface)" stroke="var(--color-border)" />
      <text x="75" y="180" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">Blockly Visual Workspace</text>
      <text x="75" y="200" fill="var(--color-text)" font-family="var(--font-mono)" font-size="10">Pinch &middot; Pan &middot; Drag Touch Gestures</text>

      <!-- Bottom Tab Bar -->
      <rect x="55" y="280" width="190" height="50" rx="6" fill="var(--color-surface-elevated)" stroke="var(--color-accent)" stroke-width="1" />
      <text x="70" y="310" fill="var(--color-text)" font-family="var(--font-mono)" font-size="10">Bottom Tab: Palette | Canvas | Props</text>

      <!-- Component Explanations -->
      <g transform="translate(300, 75)">
        <rect x="0" y="0" width="460" height="75" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="32" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="600">Adaptive GWT UiBinder Templates</text>
        <text x="20" y="55" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">Preserves single codebase compatibility for winter release (6,492 LOC modified)</text>
      </g>

      <g transform="translate(300, 165)">
        <rect x="0" y="0" width="460" height="75" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="32" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="600">Blockly Touch Coordinate Normalizer</text>
        <text x="20" y="55" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">Translates multi-touch pinches into SVG viewport matrix transforms</text>
      </g>

      <g transform="translate(300, 255)">
        <rect x="0" y="0" width="460" height="75" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="32" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="600">Contextual Drawer Controllers</text>
        <text x="20" y="55" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">Property panels and hierarchical project tree expand on demand</text>
      </g>
    </svg>
  )}

  {type === "ecommerce" && (
    <svg viewBox="0 0 800 380" fill="none" xmlns="http://www.w3.org/2000/svg" class="arch-svg">
      <rect x="2" y="2" width="796" height="376" rx="16" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1" />
      <text x="40" y="50" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12" font-weight="600" letter-spacing="1">EVENT-DRIVEN MICROSERVICES CLUSTER</text>

      <!-- Gateway & Keycloak -->
      <g transform="translate(40, 80)">
        <rect x="0" y="0" width="180" height="110" rx="10" fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="1.5" />
        <text x="20" y="35" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="700">Spring Cloud Gateway</text>
        <text x="20" y="60" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">OAuth2 Resource Server</text>
        <text x="20" y="85" fill="var(--color-accent)" font-family="var(--font-mono)" font-size="11">Validates JWT from Keycloak</text>
      </g>

      <g transform="translate(40, 220)">
        <rect x="0" y="0" width="180" height="90" rx="10" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="35" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14" font-weight="600">Keycloak 24 IAM</text>
        <text x="20" y="60" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">Realm &middot; Roles &middot; Tokens</text>
      </g>

      <!-- Central Kafka Event Bus -->
      <g transform="translate(280, 80)">
        <rect x="0" y="0" width="240" height="230" rx="12" fill="var(--color-bg)" stroke="var(--color-open-to-work)" stroke-width="2" stroke-dasharray="6 4" />
        <text x="25" y="35" fill="var(--color-open-to-work)" font-family="var(--font-mono)" font-size="13" font-weight="700">APACHE KAFKA CLUSTER</text>
        <text x="25" y="60" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">Confluent Schema Registry</text>

        <rect x="20" y="85" width="200" height="40" rx="6" fill="var(--color-surface)" />
        <text x="35" y="110" fill="var(--color-text)" font-family="var(--font-mono)" font-size="11">Topic: order-events (Avro)</text>

        <rect x="20" y="145" width="200" height="40" rx="6" fill="var(--color-surface)" />
        <text x="35" y="170" fill="var(--color-text)" font-family="var(--font-mono)" font-size="11">Topic: inventory-events</text>
      </g>

      <!-- Downstream Services -->
      <g transform="translate(580, 75)">
        <rect x="0" y="0" width="180" height="65" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="30" fill="var(--color-text)" font-family="var(--font-sans)" font-size="13" font-weight="600">Order Service</text>
        <text x="20" y="50" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="10">PostgreSQL &middot; Flyway</text>
      </g>

      <g transform="translate(580, 160)">
        <rect x="0" y="0" width="180" height="65" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="30" fill="var(--color-text)" font-family="var(--font-sans)" font-size="13" font-weight="600">Inventory Service</text>
        <text x="20" y="50" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="10">Resilience4j Circuit Breaker</text>
      </g>

      <g transform="translate(580, 245)">
        <rect x="0" y="0" width="180" height="65" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="30" fill="var(--color-text)" font-family="var(--font-sans)" font-size="13" font-weight="600">Notification Service</text>
        <text x="20" y="50" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="10">Async Consumer Queue</text>
      </g>
    </svg>
  )}

  {type === "opensource" && (
    <svg viewBox="0 0 800 360" fill="none" xmlns="http://www.w3.org/2000/svg" class="arch-svg">
      <rect x="2" y="2" width="796" height="356" rx="16" fill="var(--color-surface)" stroke="var(--color-border)" stroke-width="1" />
      <text x="40" y="50" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12" font-weight="600" letter-spacing="1">OPEN SOURCE IMPACT ACROSS 13 ORGANIZATIONS</text>

      <!-- Center Hub -->
      <g transform="translate(40, 100)">
        <rect x="0" y="0" width="200" height="200" rx="16" fill="var(--color-bg)" stroke="var(--color-accent)" stroke-width="2" />
        <text x="25" y="45" fill="var(--color-text)" font-family="var(--font-sans)" font-size="16" font-weight="700">Open Source Core</text>
        <text x="25" y="80" fill="var(--color-accent)" font-family="var(--font-mono)" font-size="28" font-weight="700">26</text>
        <text x="75" y="80" fill="var(--color-text)" font-family="var(--font-sans)" font-size="14">Merged PRs</text>
        <text x="25" y="115" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">47 Total Submitted</text>
        <text x="25" y="140" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="12">20 Repositories</text>
        <text x="25" y="165" fill="var(--color-open-to-work)" font-family="var(--font-mono)" font-size="12">13 Organizations</text>
      </g>

      <!-- Radiating Orgs -->
      <g transform="translate(300, 80)">
        <rect x="0" y="0" width="460" height="55" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="26" fill="var(--color-text)" font-family="var(--font-sans)" font-size="13" font-weight="600">Debezium Core Engine (Red Hat)</text>
        <text x="20" y="44" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">PR #7132 (false CDC error) &middot; PR #7168 (PostgreSQL TOASTed null jsonb fix)</text>
      </g>

      <g transform="translate(300, 150)">
        <rect x="0" y="0" width="460" height="55" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="26" fill="var(--color-text)" font-family="var(--font-sans)" font-size="13" font-weight="600">Kubernetes SIGs Headlamp (CNCF)</text>
        <text x="20" y="44" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">PR #4463 (Responsive UI fix for mobile &amp; tablet cluster management)</text>
      </g>

      <g transform="translate(300, 220)">
        <rect x="0" y="0" width="460" height="55" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="26" fill="var(--color-text)" font-family="var(--font-sans)" font-size="13" font-weight="600">nostream (High-Performance Nostr Relay)</text>
        <text x="20" y="44" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">PR #470 (Comprehensive unit &amp; integration test suites)</text>
      </g>

      <g transform="translate(300, 290)">
        <rect x="0" y="0" width="460" height="55" rx="8" fill="var(--color-bg)" stroke="var(--color-border)" />
        <text x="20" y="26" fill="var(--color-text)" font-family="var(--font-sans)" font-size="13" font-weight="600">Avni &middot; C4GT 2024</text>
        <text x="20" y="44" fill="var(--color-muted)" font-family="var(--font-mono)" font-size="11">Backend feature engineering for Samanway Foundation healthcare platform</text>
      </g>
    </svg>
  )}
</div>

<style>
  .diagram-wrapper {
    width: 100%;
    border-radius: var(--radius-2xl);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: var(--space-4);
    margin-block: var(--space-8);
  }

  @media (max-width: 640px) {
    .diagram-wrapper {
      padding: 0.75rem;
      border-radius: var(--radius-xl);
      margin-block: var(--space-4);
    }
    .arch-svg {
      min-width: 540px;
    }
  }

  .arch-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .anim-flow-line {
    animation: flowPulse 2s linear infinite;
  }

  @keyframes flowPulse {
    from {
      stroke-dashoffset: 20;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-flow-line {
      animation: none;
    }
  }
</style>
