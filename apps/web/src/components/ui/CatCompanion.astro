---
// Interactive Oneko-Inspired Cat Companion that Chases & Catches Cursor
// Self-contained, zero external dependency, never hides cursor, 100% smooth
---

<div id="cat-companion" class="cat-companion" aria-hidden="true">
  <!-- Animated Cat Sprite Container -->
  <div id="cat-sprite" class="cat-sprite state-idle">
    <!-- SVG Pixel Cat -->
    <svg class="cat-svg" viewBox="0 0 32 32" width="32" height="32">
      <!-- Shadow -->
      <ellipse cx="16" cy="28" rx="10" ry="3" fill="rgba(0,0,0,0.25)" />

      <!-- Tail -->
      <path class="cat-tail" d="M6 22 Q2 18 4 14 Q6 10 7 12" stroke="#FF5436" stroke-width="2.5" fill="none" stroke-linecap="round" />

      <!-- Body -->
      <ellipse cx="16" cy="21" rx="8" ry="6" fill="#1E232E" />
      <path d="M12 21 Q16 23 20 21" stroke="#FF5436" stroke-width="1.5" fill="none" />

      <!-- Head -->
      <circle cx="21" cy="15" r="5.5" fill="#1E232E" />

      <!-- Ears -->
      <polygon points="17,11 19,6 21,11" fill="#FF5436" />
      <polygon points="21,11 23,6 25,11" fill="#FF5436" />

      <!-- Eyes (Blinking / Alert) -->
      <circle class="cat-eye eye-left" cx="20" cy="14" r="1" fill="#3DDC84" />
      <circle class="cat-eye eye-right" cx="23" cy="14" r="1" fill="#3DDC84" />

      <!-- Nose & Whiskers -->
      <polygon points="21.5,15.5 22.5,15.5 22,16.5" fill="#FF8A00" />
      <line x1="18" y1="15" x2="15" y2="14" stroke="#94A3B8" stroke-width="0.8" />
      <line x1="18" y1="16" x2="15" y2="17" stroke="#94A3B8" stroke-width="0.8" />
      <line x1="24" y1="15" x2="27" y2="14" stroke="#94A3B8" stroke-width="0.8" />
      <line x1="24" y1="16" x2="27" y2="17" stroke="#94A3B8" stroke-width="0.8" />

      <!-- Paws (Run Cycle) -->
      <circle class="cat-paw paw-front" cx="22" cy="26" r="2" fill="#FFFFFF" />
      <circle class="cat-paw paw-back" cx="12" cy="26" r="2" fill="#FFFFFF" />
    </svg>

    <!-- Sleep Zzz Bubble -->
    <div id="cat-zzz" class="cat-zzz" aria-hidden="true">
      <span class="z z1">z</span>
      <span class="z z2">z</span>
      <span class="z z3">Z</span>
    </div>

    <!-- Alert Bubble -->
    <div id="cat-alert" class="cat-alert" aria-hidden="true">!</div>
  </div>
</div>

<script>
  function initCatFollower() {
    const companion = document.getElementById("cat-companion");
    const sprite = document.getElementById("cat-sprite");
    const zzz = document.getElementById("cat-zzz");
    const alertBubble = document.getElementById("cat-alert");
    if (!companion || !sprite) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || window.matchMedia("(hover: none) and (pointer: coarse)").matches || window.innerWidth < 768) {
      companion.style.display = "none";
      return;
    }

    let catX = window.innerWidth * 0.75;
    let catY = window.innerHeight * 0.45;
    let targetX = catX;
    let targetY = catY;

    let isSleeping = false;
    let lastMoveTime = Date.now();
        let stepCount = 0;

    // Track mouse coordinates
    const handleMouseMove = (e: MouseEvent) => {
      targetX = e.clientX;
      targetY = e.clientY;

      if (isSleeping) {
        isSleeping = false;
        if (zzz) zzz.style.display = "none";
        if (alertBubble) {
          alertBubble.style.display = "block";
          setTimeout(() => {
            if (alertBubble) alertBubble.style.display = "none";
          }, 600);
        }
      }
      lastMoveTime = Date.now();
    };

    window.addEventListener("mousemove", handleMouseMove, { passive: true });

    // 60fps Physics & Run Loop
    const tick = () => {
      requestAnimationFrame(tick);

      const dx = targetX - catX;
      const dy = targetY - catY;
      const dist = Math.hypot(dx, dy);

      // Check idle time for sleeping
      const idleElapsed = Date.now() - lastMoveTime;
      if (idleElapsed > 3500 && !isSleeping && dist < 40) {
        isSleeping = true;
        sprite.className = "cat-sprite state-sleeping";
        if (zzz) zzz.style.display = "flex";
      }

      if (!isSleeping) {
        // Cat is chasing cursor
        if (dist > 35) {
          sprite.className = "cat-sprite state-running";
          if (zzz) zzz.style.display = "none";

          // Running physics
          const speed = Math.min(Math.max(dist * 0.08, 3.5), 11);
          catX += (dx / dist) * speed;
          catY += (dy / dist) * speed;

          stepCount++;
          if (stepCount % 12 < 6) {
            sprite.classList.add("step-alt");
          } else {
            sprite.classList.remove("step-alt");
          }

          // Face direction
          if (dx < -2) {
            sprite.style.transform = "scaleX(-1)";
          } else if (dx > 2) {
            sprite.style.transform = "scaleX(1)";
          }
        } else {
          // Cat has caught the cursor!
          sprite.className = "cat-sprite state-scratching";
          if (zzz) zzz.style.display = "none";
        }
      }

      companion.style.transform = `translate3d(${catX - 16}px, ${catY - 16}px, 0)`;
    };

    tick();
  }

  initCatFollower();
  document.addEventListener("astro:page-load", initCatFollower);
</script>

<style>
  .cat-companion {
    position: fixed;
    top: 0;
    left: 0;
    width: 32px;
    height: 32px;
    pointer-events: none;
    z-index: 99999;
    will-change: transform;
    transform: translate3d(-100px, -100px, 0);
  }

  .cat-sprite {
    position: relative;
    width: 32px;
    height: 32px;
    transition: filter 0.2s ease;
  }

  .cat-svg {
    display: block;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.4));
  }

  /* Running Wiggle */
  .state-running.step-alt .cat-paw.paw-front {
    transform: translateY(-2px);
  }
  .state-running.step-alt .cat-paw.paw-back {
    transform: translateY(1px);
  }
  .state-running .cat-tail {
    animation: tailWag 0.3s ease-in-out infinite alternate;
    transform-origin: 6px 22px;
  }

  @keyframes tailWag {
    from { transform: rotate(-15deg); }
    to { transform: rotate(15deg); }
  }

  /* Scratching / Pawing at Cursor */
  .state-scratching .cat-paw.paw-front {
    animation: pawScratch 0.25s infinite alternate;
  }

  @keyframes pawScratch {
    from { transform: translate(1px, -3px); }
    to { transform: translate(-1px, 1px); }
  }

  /* Sleeping State */
  .state-sleeping {
    transform: scale(0.95);
    opacity: 0.9;
  }
  .state-sleeping .cat-eye {
    transform: scaleY(0.1);
  }

  /* Zzz Bubbles */
  .cat-zzz {
    position: absolute;
    top: -14px;
    right: -4px;
    display: none;
    gap: 2px;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-accent);
    pointer-events: none;
  }

  .cat-zzz .z {
    animation: floatZ 1.6s infinite;
    opacity: 0;
  }
  .cat-zzz .z1 { font-size: 0.6rem; animation-delay: 0s; }
  .cat-zzz .z2 { font-size: 0.75rem; animation-delay: 0.4s; }
  .cat-zzz .z3 { font-size: 0.9rem; animation-delay: 0.8s; }

  @keyframes floatZ {
    0% { opacity: 0; transform: translate(0, 0); }
    50% { opacity: 1; }
    100% { opacity: 0; transform: translate(6px, -12px); }
  }

  /* Alert Bubble */
  .cat-alert {
    position: absolute;
    top: -16px;
    right: 6px;
    display: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 900;
    color: #FF5436;
    animation: popAlert 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes popAlert {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }
  /* Disable on touch devices and small screens */
  @media (hover: none) and (pointer: coarse), (max-width: 768px) {
    .cat-companion {
      display: none !important;
    }
  }
</style>
