---
// CommandPalette.astro - Accessible Cmd+K command center
---

<div
  id="command-palette-backdrop"
  class="palette-backdrop"
  role="dialog"
  aria-modal="true"
  aria-label="Command palette"
  hidden
>
  <div class="palette-container glass" id="palette-container">
    <div class="palette-search-row">
      <svg class="palette-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="palette-input"
        class="palette-input"
        placeholder="Type a command or search..."
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
      />
      <button type="button" id="palette-close-btn" class="palette-close-btn" aria-label="Close command palette">
        <kbd class="palette-kbd">ESC</kbd>
      </button>
    </div>

    <div class="palette-content" id="palette-list" role="listbox">
      <!-- Section: Navigation -->
      <div class="palette-group" role="group" aria-label="Navigation">
        <div class="palette-group-title">Navigation</div>
        <a href="/" class="palette-item" role="option" data-category="nav" data-keywords="home hero about start">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          </svg>
          <span class="palette-item-text">Home</span>
          <span class="palette-item-hint">Go to start</span>
        </a>

        <a href="/work" class="palette-item" role="option" data-category="nav" data-keywords="work projects case studies debezium gsoc mit app inventor ecommerce">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
          </svg>
          <span class="palette-item-text">Selected Work</span>
          <span class="palette-item-hint">Case studies</span>
        </a>

        <a href="/stack" class="palette-item" role="option" data-category="nav" data-keywords="stack tech technologies java quarkus postgres architecture metrics github">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
          <span class="palette-item-text">Tech Stack</span>
          <span class="palette-item-hint">Skills & metrics</span>
        </a>

        <a href="/contact" class="palette-item" role="option" data-category="nav" data-keywords="contact email hire open to work reach social">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span class="palette-item-text">Contact</span>
          <span class="palette-item-hint">Get in touch</span>
        </a>
      </div>

      <!-- Section: Themes -->
      <div class="palette-group" role="group" aria-label="Themes">
        <div class="palette-group-title">Theme</div>
        <button type="button" class="palette-item" role="option" data-action="theme" data-theme="after-hours" data-keywords="theme dark mode after hours black night">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <span class="palette-item-text">Switch to After Hours</span>
          <span class="palette-item-hint">Dark theme</span>
        </button>

        <button type="button" class="palette-item" role="option" data-action="theme" data-theme="daylight" data-keywords="theme light mode daylight white day">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          </svg>
          <span class="palette-item-text">Switch to Daylight</span>
          <span class="palette-item-hint">Light theme</span>
        </button>

        <button type="button" class="palette-item" role="option" data-action="theme" data-theme="dawn" data-keywords="theme warm dawn sepia editorial cream">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 18a5 5 0 0 0-10 0"></path>
            <line x1="12" y1="9" x2="12" y2="2"></line>
            <line x1="23" y1="22" x2="1" y2="22"></line>
          </svg>
          <span class="palette-item-text">Switch to Dawn</span>
          <span class="palette-item-hint">Warm theme</span>
        </button>
      </div>

      <!-- Section: Actions & Links -->
      <div class="palette-group" role="group" aria-label="Quick Actions">
        <div class="palette-group-title">Quick Actions</div>
        <button type="button" class="palette-item" role="option" data-action="copy-email" data-keywords="copy email kumardivyanshu118 mail reach message">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <span class="palette-item-text">Copy Email Address</span>
          <span class="palette-item-hint">kumardivyanshu118@gmail.com</span>
        </button>

        <a href="https://github.com/d1vyanshu-kumar" target="_blank" rel="noopener noreferrer" class="palette-item" role="option" data-action="external" data-keywords="github code repos pull requests oss open source">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span class="palette-item-text">GitHub Profile</span>
          <span class="palette-item-hint">@d1vyanshu-kumar &nearr;</span>
        </a>

        <a href="https://linkedin.com/in/divyanshu-kumar-24026b296" target="_blank" rel="noopener noreferrer" class="palette-item" role="option" data-action="external" data-keywords="linkedin profile network connect experience">
          <svg class="palette-item-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          <span class="palette-item-text">LinkedIn Profile</span>
          <span class="palette-item-hint">divyanshu-kumar &nearr;</span>
        </a>
      </div>

      <div id="palette-no-results" class="palette-empty" hidden>
        No matching commands found.
      </div>
    </div>

    <div class="palette-footer">
      <div class="palette-shortcuts">
        <span><kbd class="palette-kbd">&uarr;</kbd> <kbd class="palette-kbd">&darr;</kbd> to navigate</span>
        <span><kbd class="palette-kbd">&crarr;</kbd> to select</span>
        <span><kbd class="palette-kbd">ESC</kbd> to dismiss</span>
      </div>
    </div>
  </div>

  <div id="palette-toast" class="palette-toast" role="status" aria-live="polite" hidden>
    Copied to clipboard!
  </div>
</div>

<script>
  function setupCommandPalette() {
    const backdrop = document.getElementById("command-palette-backdrop");
    
    const input = document.getElementById("palette-input") as HTMLInputElement | null;
    const closeBtn = document.getElementById("palette-close-btn");
    const items = Array.from(document.querySelectorAll<HTMLElement>(".palette-item"));
    const groups = Array.from(document.querySelectorAll<HTMLElement>(".palette-group"));
    const noResults = document.getElementById("palette-no-results");
    const toast = document.getElementById("palette-toast");

    let lastFocusedElement: HTMLElement | null = null;
    let selectedIndex = 0;

    function getVisibleItems() {
      return items.filter((item) => !item.hidden);
    }

    function updateHighlight() {
      const visible = getVisibleItems();
      items.forEach((item) => {
        item.classList.remove("palette-item-active");
        item.setAttribute("aria-selected", "false");
      });

      if (visible.length > 0) {
        if (selectedIndex >= visible.length) selectedIndex = 0;
        if (selectedIndex < 0) selectedIndex = visible.length - 1;
        const current = visible[selectedIndex];
        current.classList.add("palette-item-active");
        current.setAttribute("aria-selected", "true");
        current.scrollIntoView({ block: "nearest" });
      }
    }

    function openPalette() {
      if (!backdrop || !input) return;
      lastFocusedElement = document.activeElement as HTMLElement;
      backdrop.hidden = false;
      document.body.style.overflow = "hidden";
      input.value = "";
      filterItems("");
      selectedIndex = 0;
      updateHighlight();
      setTimeout(() => input.focus(), 20);
    }

    function closePalette() {
      if (!backdrop) return;
      backdrop.hidden = true;
      document.body.style.overflow = "";
      if (lastFocusedElement) {
        lastFocusedElement.focus();
      }
    }

    function filterItems(query: string) {
      const clean = query.trim().toLowerCase();
      let totalVisible = 0;

      items.forEach((item) => {
        const text = (item.textContent || "").toLowerCase();
        const keywords = (item.getAttribute("data-keywords") || "").toLowerCase();
        const match = !clean || text.includes(clean) || keywords.includes(clean);
        item.hidden = !match;
        if (match) totalVisible++;
      });

      groups.forEach((group) => {
        const hasVisible = Array.from(group.querySelectorAll(".palette-item")).some(
          (i) => !(i as HTMLElement).hidden
        );
        group.hidden = !hasVisible;
      });

      if (noResults) {
        noResults.hidden = totalVisible > 0;
      }

      selectedIndex = 0;
      updateHighlight();
    }

    function showToast(msg: string) {
      if (!toast) return;
      toast.textContent = msg;
      toast.hidden = false;
      setTimeout(() => {
        toast.hidden = true;
      }, 2000);
    }

    function executeItem(item: HTMLElement) {
      const action = item.getAttribute("data-action");
      if (action === "theme") {
        const newTheme = item.getAttribute("data-theme");
        if (newTheme) {
          document.documentElement.setAttribute("data-theme", newTheme);
          localStorage.setItem("theme", newTheme);
          showToast(`Theme switched to ${newTheme}`);
          setTimeout(closePalette, 300);
        }
      } else if (action === "copy-email") {
        navigator.clipboard.writeText("kumardivyanshu118@gmail.com").then(() => {
          showToast("Email copied to clipboard!");
          setTimeout(closePalette, 400);
        });
      } else if (item.tagName.toLowerCase() === "a") {
        const href = item.getAttribute("href");
        const target = item.getAttribute("target");
        if (href) {
          if (target === "_blank") {
            window.open(href, "_blank", "noopener,noreferrer");
            closePalette();
          } else {
            closePalette();
            window.location.href = href;
          }
        }
      }
    }

    // Global shortcut Cmd+K or Ctrl+K
    window.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (backdrop?.hidden) {
          openPalette();
        } else {
          closePalette();
        }
      } else if (e.key === "Escape" && !backdrop?.hidden) {
        e.preventDefault();
        closePalette();
      }
    });

    // Input events
    input?.addEventListener("input", (e) => {
      filterItems((e.target as HTMLInputElement).value);
    });

    input?.addEventListener("keydown", (e) => {
      const visible = getVisibleItems();
      if (e.key === "ArrowDown") {
        e.preventDefault();
        selectedIndex++;
        updateHighlight();
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        selectedIndex--;
        updateHighlight();
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (visible[selectedIndex]) {
          executeItem(visible[selectedIndex]);
        }
      }
    });

    // Click outside to dismiss
    backdrop?.addEventListener("click", (e) => {
      if (e.target === backdrop) {
        closePalette();
      }
    });

    closeBtn?.addEventListener("click", closePalette);

    // Item click
    items.forEach((item) => {
      item.addEventListener("click", (e) => {
        e.preventDefault();
        executeItem(item);
      });
      item.addEventListener("mouseenter", () => {
        const visible = getVisibleItems();
        const idx = visible.indexOf(item);
        if (idx !== -1) {
          selectedIndex = idx;
          updateHighlight();
        }
      });
    });

    // Public triggers
    document.querySelectorAll("[data-open-command-palette]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        openPalette();
      });
    });
  }

  // Support both initial load and Astro View Transitions
  setupCommandPalette();
  document.addEventListener("astro:page-load", setupCommandPalette);
</script>

<style>
  .palette-backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background-color: var(--color-overlay);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: calc(var(--space-16) + 2rem) var(--space-4) var(--space-8);
  }

  .palette-backdrop[hidden] {
    display: none !important;
  }

  .palette-container {
    width: 100%;
    max-width: 36rem;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg), 0 0 0 1px var(--color-glass-border);
    animation: paletteSlideIn var(--duration-fast) var(--ease-spring);
  }

  @keyframes paletteSlideIn {
    from {
      opacity: 0;
      transform: translateY(-0.75rem) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .palette-container {
      animation: none;
    }
  }

  .palette-search-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .palette-search-icon {
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .palette-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--color-text);
    font-size: var(--text-base);
    font-family: var(--font-sans);
    outline: none;
  }

  .palette-input::placeholder {
    color: var(--color-muted);
  }

  .palette-close-btn {
    display: flex;
    align-items: center;
    color: var(--color-muted);
    padding: 0;
  }

  .palette-kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.15rem 0.4rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .palette-content {
    max-height: 24rem;
    overflow-y: auto;
    padding: var(--space-3) var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .palette-group {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .palette-group-title {
    font-size: var(--text-xs);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    font-weight: var(--weight-semibold);
    padding: var(--space-2) var(--space-3) var(--space-1);
  }

  .palette-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-3);
    border-radius: var(--radius-md);
    color: var(--color-text);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
    min-height: 44px;
    width: 100%;
    text-align: left;
  }

  .palette-item[hidden] {
    display: none !important;
  }

  .palette-item-icon {
    color: var(--color-muted);
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .palette-item-text {
    flex: 1;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .palette-item-hint {
    font-size: var(--text-xs);
    color: var(--color-muted);
    font-family: var(--font-mono);
  }

  .palette-item:hover,
  .palette-item-active {
    background-color: var(--color-accent-subtle);
    color: var(--color-text);
  }

  .palette-item:hover .palette-item-icon,
  .palette-item-active .palette-item-icon {
    color: var(--color-accent);
  }

  .palette-empty {
    padding: var(--space-8);
    text-align: center;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .palette-footer {
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: flex-end;
  }

  .palette-shortcuts {
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .palette-toast {
    position: fixed;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    box-shadow: var(--shadow-lg);
    z-index: calc(var(--z-modal) + 1);
  }

  /* Mobile Responsive Optimization for Command Palette */
  @media (max-width: 640px) {
    .palette-backdrop {
      padding: 1.5rem 0.75rem;
      align-items: flex-start;
    }
    .palette-container {
      border-radius: var(--radius-xl);
    }
    .palette-search-row {
      padding: 0.75rem 0.85rem;
    }
    .palette-content {
      max-height: 55dvh;
    }
    .palette-shortcuts {
      display: none;
    }
    .palette-footer {
      display: none;
    }
  }
</style>
