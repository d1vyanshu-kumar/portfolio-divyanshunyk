  function drawPixelMatrix(
    ctx: CanvasRenderingContext2D,
    matrix: string[],
    x: number,
    y: number,
    pixelSize: number,
    color: string
  ) {
    ctx.fillStyle = color;
    for (let r = 0; r < matrix.length; r++) {
      const row = matrix[r];
      for (let c = 0; c < row.length; c++) {
        if (row[c] === "#" || row[c] === "X") {
          ctx.fillRect(Math.round(x + c * pixelSize), Math.round(y + r * pixelSize), pixelSize, pixelSize);
        }
      }
    }
  }

  // ==========================================
  // Web Audio Synth for Retro 8-bit Sounds
  // ==========================================
  let audioCtx: AudioContext | null = null;
  function getAudio() {
    try {
      if (!audioCtx) {
        const AudioClass = window.AudioContext || (window as any).webkitAudioContext;
        if (AudioClass) audioCtx = new AudioClass();
      }
      if (audioCtx && audioCtx.state === "suspended") {
        audioCtx.resume();
      }
    } catch (e) {}
    return audioCtx;
  }

  function playSound(type: "jump" | "score" | "crash") {
    try {
      const ctx = getAudio();
      if (!ctx) return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      if (type === "jump") {
        osc.type = "square";
        osc.frequency.setValueAtTime(150, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(600, ctx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.06, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.1);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.1);
      } else if (type === "score") {
        osc.type = "sine";
        osc.frequency.setValueAtTime(620, ctx.currentTime);
        osc.frequency.setValueAtTime(900, ctx.currentTime + 0.08);
        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.22);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.22);
      } else if (type === "crash") {
        osc.type = "sawtooth";
        osc.frequency.setValueAtTime(260, ctx.currentTime);
        osc.frequency.linearRampToValueAtTime(80, ctx.currentTime + 0.25);
        gain.gain.setValueAtTime(0.1, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.25);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.25);
      }
    } catch (e) {}
  }

  // ==========================================
  // 1. Mini Auto-Playing Dino (Inside Nav Circle)
  // ==========================================
  let miniDinoAnimationId: number | null = null;

  function initMiniDino() {
    const canvas = document.getElementById("mini-dino-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    if (miniDinoAnimationId) {
      cancelAnimationFrame(miniDinoAnimationId);
      miniDinoAnimationId = null;
    }

    const miniDino = {
      x: 14,
      y: 40,
      baseY: 40,
      vy: 0,
      isJumping: false,
      width: 20 * 1.3,
      height: 20 * 1.3,
    };

    const miniCactus = {
      x: 95,
      y: 52,
      width: 8 * 1.3,
      height: 10 * 1.3,
      speed: 2.1
    };

    let frame = 0;

    function loop() {
      if (!canvas || !ctx) return;
      ctx.clearRect(0, 0, 88, 88);

      // Circular clip so elements don't bleed outside the round button
      ctx.save();
      ctx.beginPath();
      ctx.arc(44, 44, 42, 0, Math.PI * 2);
      ctx.clip();

      const groundY = 66;

      // Ground line
      ctx.fillStyle = "rgba(255, 255, 255, 0.45)";
      ctx.fillRect(4, groundY, 80, 1.5);

      // Ground texture / pebbles scrolling
      const pebbleOffset = (frame * 2.1) % 20;
      ctx.fillStyle = "rgba(255, 255, 255, 0.75)";
      for (let px = 8 - pebbleOffset; px < 80; px += 20) {
        if (px >= 6 && px <= 78) {
          ctx.fillRect(px, groundY + 4, 3, 1.5);
        }
      }

      // Move mini cactus
      miniCactus.x -= miniCactus.speed;
      if (miniCactus.x < -18) {
        miniCactus.x = 92 + Math.random() * 32;
      }

      // Auto-jump logic (computer automatically plays it)
      const dist = miniCactus.x - (miniDino.x + miniDino.width);
      if (dist < 14 && !miniDino.isJumping && dist > -4) {
        miniDino.vy = -7.6;
        miniDino.isJumping = true;
      }

      if (miniDino.isJumping) {
        miniDino.vy += 0.42;
        miniDino.y += miniDino.vy;
        if (miniDino.y >= miniDino.baseY) {
          miniDino.y = miniDino.baseY;
          miniDino.vy = 0;
          miniDino.isJumping = false;
        }
      }

      // Sprite selection
      let sprite = SPRITES.DINO_JUMP;
      if (!miniDino.isJumping) {
        const leg = Math.floor(frame / 5) % 2;
        sprite = leg === 0 ? SPRITES.DINO_RUN_1 : SPRITES.DINO_RUN_2;
      }

      // Draw Dino & Cactus in crisp white
      drawPixelMatrix(ctx, sprite, miniDino.x, miniDino.y, 1.3, "#FFFFFF");
      drawPixelMatrix(ctx, SPRITES.CACTUS_SMALL, miniCactus.x, miniCactus.y, 1.3, "#FFFFFF");

      ctx.restore();
      frame++;
      miniDinoAnimationId = requestAnimationFrame(loop);
    }

    miniDinoAnimationId = requestAnimationFrame(loop);
  }

  // ==========================================
  // 2. Full Interactive Dino Game Modal
  // ==========================================
  let mainGameAnimationId: number | null = null;
  
  interface Obstacle {
    type: "cactus_small" | "cactus_double" | "cactus_tall" | "bird";
    x: number;
    y: number;
    w: number;
    h: number;
    pixelSize: number;
    sprite: string[];
    matrix: string[];
    birdFrame?: number;
  }

  function setupDinoGameModal() {
    const triggerBtn = document.getElementById("dino-nav-btn");
    const modalBackdrop = document.getElementById("dino-game-modal");
    const closeBtn = document.getElementById("dino-close-btn");
    const canvas = document.getElementById("main-dino-canvas") as HTMLCanvasElement | null;
    const hiScoreEl = document.getElementById("dino-hi-score");
    const currScoreEl = document.getElementById("dino-curr-score");

    if (!triggerBtn || !modalBackdrop || !canvas || (triggerBtn as any).__dinoInitialized) return;
    (triggerBtn as any).__dinoInitialized = true;

    let highScore = parseInt(localStorage.getItem("dino_high_score") || "0", 10) || 0;
    if (hiScoreEl) {
      hiScoreEl.textContent = "HI " + String(highScore).padStart(5, "0");
    }

    // Game state
    let state: "READY" | "PLAYING" | "GAMEOVER" = "READY";
    let score = 0;
    let speed = 6;
    let frame = 0;
    let lastObstacleSpawn = 0;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const groundY = 150;
    const dino = {
      x: 40,
      y: groundY - 40,
      baseY: groundY - 40,
      vy: 0,
      w: 40,
      h: 40,
      pixelSize: 2,
      isJumping: false,
      isDucking: false,
    };

    let obstacles: Obstacle[] = [];
    let clouds: { x: number; y: number; speed: number }[] = [
      { x: 120, y: 35, speed: 0.6 },
      { x: 340, y: 25, speed: 0.4 },
      { x: 520, y: 45, speed: 0.5 },
    ];

    function getThemeColors() {
      const theme = document.documentElement.getAttribute("data-theme") || "dawn";
      if (theme === "after-hours") {
        return {
          bg: "#0B0B0D",
          text: "#F1F5F9",
          accent: "#FF5436",
          ground: "rgba(255, 255, 255, 0.2)",
          cloud: "rgba(255, 255, 255, 0.15)",
        };
      } else if (theme === "daylight") {
        return {
          bg: "#FFFFFF",
          text: "#1E293B",
          accent: "#EA580C",
          ground: "rgba(0, 0, 0, 0.2)",
          cloud: "rgba(0, 0, 0, 0.12)",
        };
      } else {
        // dawn (default)
        return {
          bg: "#FDF9F0",
          text: "#23180F",
          accent: "#B23D15",
          ground: "rgba(43, 33, 24, 0.25)",
          cloud: "rgba(43, 33, 24, 0.15)",
        };
      }
    }

    function resetGame() {
      score = 0;
      speed = 6.2;
      frame = 0;
      lastObstacleSpawn = 0;
      obstacles = [];
      dino.y = dino.baseY;
      dino.vy = 0;
      dino.isJumping = false;
      dino.isDucking = false;
      state = "PLAYING";
      playSound("jump");
    }

    function jump() {
      if (state === "READY") {
        resetGame();
        return;
      }
      if (state === "GAMEOVER") {
        resetGame();
        return;
      }
      if (state === "PLAYING" && !dino.isJumping && !dino.isDucking) {
        dino.vy = -12.4;
        dino.isJumping = true;
        playSound("jump");
      }
    }

    function setDuck(ducking: boolean) {
      if (state === "PLAYING" && !dino.isJumping) {
        dino.isDucking = ducking;
      }
    }

    function spawnObstacle() {
      const minDistance = Math.max(70, 110 - Math.floor(speed * 3));
      if (frame - lastObstacleSpawn < minDistance) return;

      const types: ("cactus_small" | "cactus_double" | "cactus_tall" | "bird")[] = ["cactus_small", "cactus_double", "cactus_tall"];
      if (score > 180) {
        types.push("bird");
      }

      const type = types[Math.floor(Math.random() * types.length)];
      lastObstacleSpawn = frame;

      if (type === "cactus_small") {
        obstacles.push({
          type,
          x: 610,
          y: groundY - 20,
          w: 8 * 2,
          h: 10 * 2,
          pixelSize: 2,
          sprite: SPRITES.CACTUS_SMALL,
          matrix: SPRITES.CACTUS_SMALL,
        });
      } else if (type === "cactus_double") {
        obstacles.push({
          type,
          x: 610,
          y: groundY - 20,
          w: 18 * 2,
          h: 10 * 2,
          pixelSize: 2,
          sprite: SPRITES.CACTUS_DOUBLE,
          matrix: SPRITES.CACTUS_DOUBLE,
        });
      } else if (type === "cactus_tall") {
        obstacles.push({
          type,
          x: 610,
          y: groundY - 26,
          w: 11 * 2,
          h: 13 * 2,
          pixelSize: 2,
          sprite: SPRITES.CACTUS_TALL,
          matrix: SPRITES.CACTUS_TALL,
        });
      } else if (type === "bird") {
        const altitudes = [groundY - 18, groundY - 34, groundY - 50];
        const birdY = altitudes[Math.floor(Math.random() * altitudes.length)];
        obstacles.push({
          type,
          x: 610,
          y: birdY,
          w: 14 * 2,
          h: 9 * 2,
          pixelSize: 2,
          sprite: SPRITES.BIRD_1,
          matrix: SPRITES.BIRD_1,
          birdFrame: 0,
        });
      }
    }

    function checkCollision(obs: Obstacle): boolean {
      const pad = 4;
      const dinoBox = dino.isDucking
        ? {
            x: dino.x + pad,
            y: groundY - 22 + pad,
            w: 32 * 2 - pad * 2,
            h: 11 * 2 - pad * 2,
          }
        : {
            x: dino.x + pad,
            y: dino.y + pad,
            w: dino.w - pad * 2,
            h: dino.h - pad * 2,
          };

      const obsBox = {
        x: obs.x + pad,
        y: obs.y + pad,
        w: obs.w - pad * 2,
        h: obs.h - pad * 2,
      };

      return (
        dinoBox.x < obsBox.x + obsBox.w &&
        dinoBox.x + dinoBox.w > obsBox.x &&
        dinoBox.y < obsBox.y + obsBox.h &&
        dinoBox.y + dinoBox.h > obsBox.y
      );
    }

    function updateAndRender() {
      if (!ctx || !canvas) return;
      const colors = getThemeColors();

      ctx.fillStyle = colors.bg;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      // Render clouds
      ctx.fillStyle = colors.cloud;
      clouds.forEach((cloud) => {
        cloud.x -= cloud.speed;
        if (cloud.x < -40) cloud.x = canvas.width + Math.random() * 50;
        drawPixelMatrix(ctx, SPRITES.CLOUD, cloud.x, cloud.y, 2, colors.cloud);
      });

      // Ground Line
      ctx.fillStyle = colors.ground;
      ctx.fillRect(0, groundY, canvas.width, 2);

      // Ground pebbles
      const pebbleOffset = (frame * speed) % 24;
      for (let px = -pebbleOffset; px < canvas.width; px += 24) {
        ctx.fillRect(px, groundY + 4, 4, 2);
      }

      if (state === "PLAYING") {
        score += 0.15;
        speed = 6.2 + Math.min(score / 220, 6);

        // Milestone score chime
        if (Math.floor(score) > 0 && Math.floor(score) % 100 === 0 && Math.floor(score - 0.15) % 100 !== 0) {
          playSound("score");
        }

        // Update score UI
        if (currScoreEl) {
          currScoreEl.textContent = String(Math.floor(score)).padStart(5, "0");
        }
        if (score > highScore) {
          highScore = Math.floor(score);
          localStorage.setItem("dino_high_score", String(highScore));
          if (hiScoreEl) {
            hiScoreEl.textContent = "HI " + String(highScore).padStart(5, "0");
          }
        }

        // Dino Physics
        if (dino.isJumping) {
          dino.vy += 0.65;
          dino.y += dino.vy;
          if (dino.y >= dino.baseY) {
            dino.y = dino.baseY;
            dino.vy = 0;
            dino.isJumping = false;
          }
        }

        // Spawn obstacles
        spawnObstacle();

        // Update obstacles
        for (let i = obstacles.length - 1; i >= 0; i--) {
          const obs = obstacles[i];
          obs.x -= speed;

          if (obs.type === "bird") {
            const flap = Math.floor(frame / 6) % 2;
            obs.matrix = flap === 0 ? SPRITES.BIRD_1 : SPRITES.BIRD_2;
          }

          if (checkCollision(obs)) {
            state = "GAMEOVER";
            playSound("crash");
          }

          if (obs.x < -50) {
            obstacles.splice(i, 1);
          }
        }
      }

      // Draw obstacles
      obstacles.forEach((obs) => {
        drawPixelMatrix(ctx, obs.matrix, obs.x, obs.y, obs.pixelSize, colors.text);
      });

      // Draw Dino
      let dinoMatrix = SPRITES.DINO_JUMP;
      let drawY = dino.y;

      if (state === "GAMEOVER") {
        dinoMatrix = SPRITES.DINO_CRASH;
      } else if (dino.isDucking) {
        const duckStep = Math.floor(frame / 5) % 2;
        dinoMatrix = duckStep === 0 ? SPRITES.DINO_DUCK_1 : SPRITES.DINO_DUCK_2;
        drawY = groundY - 32;
      } else if (!dino.isJumping) {
        const leg = Math.floor(frame / 5) % 2;
        dinoMatrix = leg === 0 ? SPRITES.DINO_RUN_1 : SPRITES.DINO_RUN_2;
      }

      drawPixelMatrix(ctx, dinoMatrix, dino.x, drawY, dino.pixelSize, colors.text);

      // Overlays
      if (state === "READY") {
        ctx.fillStyle = colors.text;
        ctx.font = "bold 14px monospace";
        ctx.textAlign = "center";
        ctx.fillText("PRESS [SPACE] OR TAP TO START", canvas.width / 2, groundY - 60);
      } else if (state === "GAMEOVER") {
        ctx.fillStyle = colors.accent;
        ctx.font = "bold 16px monospace";
        ctx.textAlign = "center";
        ctx.fillText("G A M E   O V E R", canvas.width / 2, groundY - 65);

        ctx.fillStyle = colors.text;
        ctx.font = "12px monospace";
        ctx.fillText("PRESS [SPACE] OR TAP TO RETRY", canvas.width / 2, groundY - 42);
      }

      frame++;
      mainGameAnimationId = requestAnimationFrame(updateAndRender);
    }

    // Keyboard controls
    function handleKeyDown(e: KeyboardEvent) {
      if (modalBackdrop && !modalBackdrop.classList.contains("open")) return;

      if (e.code === "Space" || e.code === "ArrowUp" || e.code === "KeyW") {
        e.preventDefault();
        jump();
      } else if (e.code === "ArrowDown" || e.code === "KeyS") {
        e.preventDefault();
        setDuck(true);
      } else if (e.code === "Escape") {
        e.preventDefault();
        closeModal();
      }
    }

    function handleKeyUp(e: KeyboardEvent) {
      if (e.code === "ArrowDown" || e.code === "KeyS") {
        setDuck(false);
      }
    }

    function openModal() {
      if (!modalBackdrop) return;
      modalBackdrop.classList.add("open");
      modalBackdrop.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      window.addEventListener("keydown", handleKeyDown);
      window.addEventListener("keyup", handleKeyUp);

      if (state === "READY" || state === "GAMEOVER") {
        state = "READY";
      }

      if (!mainGameAnimationId) {
        mainGameAnimationId = requestAnimationFrame(updateAndRender);
      }
    }

    function closeModal() {
      if (!modalBackdrop) return;
      modalBackdrop.classList.remove("open");
      modalBackdrop.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      window.removeEventListener("keydown", handleKeyDown);
      window.removeEventListener("keyup", handleKeyUp);

      if (mainGameAnimationId) {
        cancelAnimationFrame(mainGameAnimationId);
        mainGameAnimationId = null;
      }
    }

    // Click triggers
    triggerBtn.addEventListener("click", (e) => {
      e.preventDefault();
      openModal();
    });

    closeBtn?.addEventListener("click", closeModal);

    // Click outside modal card to close
    modalBackdrop.addEventListener("click", (e) => {
      if (e.target === modalBackdrop) {
        closeModal();
      }
    });

    // Tap/Click on canvas to jump/start
    canvas.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      jump();
    });
  }

  // ==========================================
  // Standard Nav & Theme Handlers
  // ==========================================
  function setupThemeToggle() {
    const themeOrder = ["dawn", "daylight", "after-hours"] as const;
    const toggle = document.getElementById("theme-toggle");

    if (toggle) {
      toggle.onclick = () => {
        const current = (document.documentElement.getAttribute("data-theme") || "dawn") as (typeof themeOrder)[number];
        const idx = themeOrder.indexOf(current);
        const next = themeOrder[(idx + 1) % themeOrder.length];
        
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("theme", next);
        } catch (e) {}

        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          const colorMap: Record<string, string> = {
            "dawn": "#F4EAD4",
            "daylight": "#FFFFFF",
            "after-hours": "#0B0B0D"
          };
          meta.setAttribute("content", colorMap[next] || "#F4EAD4");
        }

        window.dispatchEvent(new CustomEvent("theme-change", { detail: { theme: next } }));
      };
    }
  }

  function syncActiveNav() {
    const rawPath = window.location.pathname;
    const current = rawPath.replace(/\/+$/, "") || "/";
    const links = document.querySelectorAll<HTMLAnchorElement>(".nav-dock .nav-link");

    links.forEach((link) => {
      const href = (link.getAttribute("href") || "").replace(/\/+$/, "") || "/";
      const isActive =
        href === "/"
          ? current === "/"
          : current === href || current.startsWith(href + "/");

      if (isActive) {
        link.classList.add("active");
        link.setAttribute("aria-current", "page");
      } else {
        link.classList.remove("active");
        link.removeAttribute("aria-current");
      }
    });
  }

  function bindLinkClicks() {
    const links = document.querySelectorAll<HTMLAnchorElement>(".nav-dock .nav-link");
    links.forEach((link) => {
      if ((link as any).__hasActiveNavClick) return;
      (link as any).__hasActiveNavClick = true;
      link.addEventListener("click", () => {
        links.forEach((l) => {
          l.classList.remove("active");
          l.removeAttribute("aria-current");
        });
        link.classList.add("active");
        link.setAttribute("aria-current", "page");
      });
    });
  }

  function initAll() {
    setupThemeToggle();
    syncActiveNav();
    bindLinkClicks();
    initMiniDino();
    setupDinoGameModal();
  }

  initAll();

  document.addEventListener("astro:page-load", () => {
    initAll();
  });

  window.addEventListener("popstate", syncActiveNav);
</script>

