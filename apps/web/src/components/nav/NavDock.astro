---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work" },
  { label: "Stack", href: "/stack" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="nav-header" id="nav-header" transition:persist="nav-header">
  <nav class="nav-dock glass" aria-label="Main navigation">
    <!-- Dino Runner Easter Egg & Home button -->
    <button
      type="button"
      class="nav-logo dino-trigger-btn"
      id="dino-nav-btn"
      aria-label="Play Offline Chrome Dino runner easter egg. Click to play."
      title="Offline Chrome Dino Runner (Click to Play!)"
    >
      <canvas id="mini-dino-canvas" class="mini-dino-canvas" width="88" height="88" aria-hidden="true"></canvas>
      <span class="sr-only">Play Chrome Dino Runner</span>
    </button>

    <ul class="nav-links" role="list">
      {navItems.map(({ label, href }) => (
        <li>
          <a
            href={href}
            class:list={["nav-link", { active: currentPath === href || (href !== "/" && currentPath.startsWith(href)) }]}
            aria-current={currentPath === href || (href !== "/" && currentPath.startsWith(href)) ? "page" : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <!-- Search / Command Palette trigger -->
      <button
        type="button"
        class="cmd-trigger-btn"
        data-open-command-palette
        aria-label="Open command palette (Command + K)"
        title="Open command palette (⌘K)"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <kbd class="kbd-badge" aria-hidden="true">⌘K</kbd>
      </button>

      <!-- 3-State Theme Toggle -->
      <button
        id="theme-toggle"
        class="theme-btn"
        type="button"
        aria-label="Cycle theme: after-hours, daylight, dawn"
        title="Cycle theme: after-hours, daylight, dawn"
      >
        <!-- Sun icon (shown in daylight) -->
        <svg class="theme-icon sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in after-hours) -->
        <svg class="theme-icon moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
        <!-- Dawn / sunrise icon (shown in dawn) -->
        <svg class="theme-icon dawn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M17 18a5 5 0 0 0-10 0"></path>
          <line x1="12" y1="9" x2="12" y2="2"></line>
          <line x1="4.22" y1="10.22" x2="5.64" y2="11.64"></line>
          <line x1="1" y1="18" x2="3" y2="18"></line>
          <line x1="21" y1="18" x2="23" y2="18"></line>
          <line x1="18.36" y1="11.64" x2="19.78" y2="10.22"></line>
          <line x1="23" y1="22" x2="1" y2="22"></line>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Dino Runner Interactive Game Modal -->
  <div id="dino-game-modal" class="dino-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-label="T-Rex Offline Runner Game">
    <div class="dino-modal-card glass" id="dino-modal-card">
      <div class="dino-modal-header">
        <div class="dino-modal-title">
          <span class="dino-radar-dot" aria-hidden="true"></span>
          <span class="dino-title-text">T-REX RUNNER // OFFLINE MODE</span>
        </div>
        <div class="dino-score-board">
          <span class="dino-hi-score" id="dino-hi-score">HI 00000</span>
          <span class="dino-curr-score" id="dino-curr-score">00000</span>
        </div>
        <button type="button" class="dino-close-btn" id="dino-close-btn" aria-label="Close Dino Game (Escape)" title="Close (ESC)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <kbd class="dino-esc-badge" aria-hidden="true">ESC</kbd>
        </button>
      </div>

      <div class="dino-canvas-wrapper">
        <canvas id="main-dino-canvas" class="main-dino-canvas" width="600" height="180" aria-label="Interactive Dino Game Canvas. Press Space or tap to jump."></canvas>
      </div>

      <div class="dino-modal-footer">
        <div class="dino-controls-hint">
          <span><kbd class="dino-kbd">SPACE</kbd> or <kbd class="dino-kbd">&uarr;</kbd> Jump</span>
          <span class="dino-hint-sep">&middot;</span>
          <span><kbd class="dino-kbd">&darr;</kbd> Duck</span>
          <span class="dino-hint-sep">&middot;</span>
          <span>Click outside to exit</span>
        </div>
        <a href="/" class="dino-home-link" title="Return to Homepage">Home &rarr;</a>
      </div>
    </div>
  </div>
</header>

<script>
